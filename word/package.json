{
  "name": "ogolgye-word",
  "productName": "오골계 워드",
  "version": "1.0.8",
  "description": "HWP 편집기 + PDF 줄바꿈 복원 보기 (로컬 전용)",
  "author": "오골계 (@5golgyeo, https://x.com/5golgyeo)",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "build-paddle-ocr": "node scripts/build-paddle-ocr.js",
    "predist": "npm run build-paddle-ocr",
    "prerelease": "npm run build-paddle-ocr",
    "serve": "node server.js",
    "build-studio": "node scripts/build-studio.js",
    "get-model": "node scripts/get-kiwi-model.js",
    "check-exports": "node scripts/check-export-files.js",
    "check-pdf-pipeline": "node scripts/check-pdf-pipeline.js",
    "check-ruby-engine": "node scripts/check-ruby-engine.js",
    "check-boxes": "node scripts/check-boxes.js",
    "check-pdf-scheduler": "node scripts/check-pdf-scheduler.js",
    "check-api-tools": "node scripts/check-api-tools.js",
    "check-security": "node scripts/check-security.js",
    "check-pdf-export": "electron scripts/check-pdf-export.js",
    "dist": "electron-builder --publish never",
    "release": "electron-builder --publish always",
    "build-engine": "node scripts/build-engine.js"
  },
  "dependencies": {
    "@hyzyla/pdfium": "^2.1.13",
    "@phosphor-icons/web": "^2.1.2",
    "@rhwp/core": "0.8.6",
    "@rhwp/editor": "0.8.6",
    "clipper-lib": "^6.4.2",
    "electron-updater": "^6.8.9",
    "jpeg-js": "^0.4.4",
    "js-yaml": "^4.3.2",
    "kiwi-nlp": "^0.24.0",
    "onnxruntime-node": "^1.30.0",
    "pngjs": "^7.0.0",
    "tar": "^7.5.22",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@paddleocr/paddleocr-js": "^0.4.2",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.12"
  },
  "build": {
    "appId": "com.ogolgye.word",
    "productName": "오골계 워드",
    "electronVersion": "44.6.0",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": true,
    "asarUnpack": [
      "models/**",
      "node_modules/kiwi-nlp/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/@hyzyla/pdfium/**"
    ],
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "files": [
      "main.js",
      "preload.cjs",
      "paddle-preload.cjs",
      "server.js",
      "package.json",
      "release-notes.json",
      "LICENSE",
      "core/**",
      "renderer/**",
      "assets/**",
      "vendor/**",
      "models/**",
      "licenses/**",
      "!**/*.log",
      "!**/*.map",
      "!**/.DS_Store",
      "!**/Thumbs.db",
      "!node_modules/**/.github/**",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/docs/**",
      "!node_modules/**/example/**",
      "!node_modules/**/examples/**",
      "!node_modules/**/coverage/**",
      "!node_modules/**/CHANGELOG*",
      "!node_modules/**/CONTRIBUTING*",
      "!node_modules/**/README*",
      "!node_modules/onnxruntime-node/bin/napi-v6/!(${platform})/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/**/DirectML.dll",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/**/dxcompiler.dll",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/**/dxil.dll",
      "!node_modules/onnxruntime-node/dist/*.map",
      "!node_modules/onnxruntime-node/lib/**",
      "!node_modules/onnxruntime-node/script/**",
      "!node_modules/@phosphor-icons/web/src/**",
      "node_modules/@phosphor-icons/web/src/regular/style.css",
      "node_modules/@phosphor-icons/web/src/regular/Phosphor.woff2",
      "!node_modules/tesseract.js-core/*.wasm.js",
      "!node_modules/@hyzyla/pdfium/dist/**/*.d.ts",
      "!node_modules/@hyzyla/pdfium/dist/index.cjs",
      "!node_modules/@hyzyla/pdfium/dist/index.esm.base64.js",
      "!node_modules/@hyzyla/pdfium/dist/index.esm.browser.js",
      "!node_modules/@hyzyla/pdfium/dist/index.esm.cdn.js",
      "!node_modules/@hyzyla/pdfium/dist/index.esm.worker.js",
      "!node_modules/@hyzyla/pdfium/dist/worker.bundle.js",
      "!node_modules/@hyzyla/pdfium/dist/pdfium.wasm.base64-*.js",
      "!node_modules/tesseract.js/karma.conf.js",
      "!node_modules/tesseract.js/scripts/**",
      "!vendor/rhwp-studio/*.d.ts",
      "!vendor/rhwp-studio/manifest.webmanifest",
      "!vendor/rhwp-studio/fonts/D2Coding-Bold.woff2",
      "!vendor/rhwp-studio/fonts/GowunBatang-Bold.woff2",
      "!vendor/rhwp-studio/fonts/NanumGothic-Bold.woff2",
      "!vendor/rhwp-studio/fonts/NanumGothic-ExtraBold.woff2",
      "!vendor/rhwp-studio/fonts/NanumGothicCoding-Bold.woff2",
      "!vendor/rhwp-studio/fonts/NanumMyeongjo-Bold.woff2",
      "!vendor/rhwp-studio/fonts/NanumMyeongjo-ExtraBold.woff2"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Ogolgye-Word-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "오골계 워드",
      "uninstallDisplayName": "오골계 워드",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "artifactName": "Ogolgye-Word-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "Ogolgye-Word-${version}-mac-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "OHgolgyeo",
        "repo": "office",
        "releaseType": "release"
      }
    ]
  }
}
